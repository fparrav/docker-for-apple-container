{
  "name": "bsec",
  "networks": {
    "default": {
      "name": "bsec_default",
      "ipam": {}
    }
  },
  "secrets": {
    "api_key": {
      "name": "bsec_api_key",
      "environment": "API_KEY"
    },
    "npm_token": {
      "name": "bsec_npm_token",
      "file": "__PROJECT_DIR__/npm-token.txt"
    },
    "runtime_only": {
      "name": "bsec_runtime_only",
      "file": "__PROJECT_DIR__/runtime.txt"
    }
  },
  "services": {
    "api": {
      "command": null,
      "entrypoint": null,
      "image": "alpine:3.20",
      "networks": {
        "default": null
      },
      "secrets": [
        {
          "source": "runtime_only",
          "target": "/run/secrets/runtime_only"
        }
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "data",
          "target": "/data",
          "volume": {}
        }
      ],
      "build": {
        "context": "__PROJECT_DIR__",
        "dockerfile": "Dockerfile",
        "secrets": [
          {
            "source": "npm_token"
          },
          {
            "source": "api_key",
            "target": "registry"
          }
        ]
      }
    }
  },
  "volumes": {
    "data": {
      "name": "bsec_data",
      "labels": {
        "cost": "$$5"
      }
    }
  }
}
